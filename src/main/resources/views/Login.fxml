<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.mediclinic.controllers.LoginController"
           styleClass="login-background"
           prefWidth="1024.0" prefHeight="680.0">

    <VBox alignment="CENTER" maxWidth="440.0" maxHeight="520.0" styleClass="login-card" spacing="20.0">
        <!-- Logo / Icon Area -->
        <VBox alignment="CENTER" spacing="6.0">
            <Label text="🏥" style="-fx-font-size: 38px;" />
            <Label text="MediClinic Pro" styleClass="app-title" />
            <Label text="Sistema de Gestión Médica Integral" styleClass="greeting-sublabel" />
        </VBox>

        <!-- Divider line -->
        <Separator prefWidth="360.0" />

        <!-- Form fields -->
        <VBox spacing="14.0" prefWidth="360.0">
            <VBox spacing="5.0">
                <Label text="Usuario" styleClass="field-label" />
                <TextField fx:id="txtUsername" promptText="Ingresa tu usuario (ej. doctor / secretaria)" onAction="#handleLogin" />
            </VBox>

            <VBox spacing="5.0">
                <Label text="Contraseña" styleClass="field-label" />
                <PasswordField fx:id="txtPassword" promptText="••••••••" onAction="#handleLogin" />
            </VBox>

            <!-- Error Label -->
            <Label fx:id="lblError" styleClass="error-message" visible="false" wrapText="true" />

            <!-- Login Button -->
            <Button fx:id="btnLogin" text="Iniciar Sesión" onAction="#handleLogin" defaultButton="true"
                    styleClass="btn-primary" maxWidth="Infinity" prefHeight="42.0" />
        </VBox>

        <!-- Quick Access Hints for Demo -->
        <VBox alignment="CENTER" spacing="4.0" style="-fx-background-color: #f8fafc; -fx-padding: 10px; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px;">
            <Label text="Acceso Rápido de Demostración:" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #475569;" />
            <HBox alignment="CENTER" spacing="12.0">
                <Hyperlink text="Doctor (doctor / 1234)" onAction="#fillDoctorDemo" style="-fx-font-size: 11px; -fx-text-fill: #0ea5e9;" />
                <Label text="|" textFill="#94a3b8" />
                <Hyperlink text="Secretaria (secretaria / 1234)" onAction="#fillSecretaryDemo" style="-fx-font-size: 11px; -fx-text-fill: #6366f1;" />
            </HBox>
        </VBox>
    </VBox>

</StackPane>
