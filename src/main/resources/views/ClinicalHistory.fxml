<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.mediclinic.controllers.ClinicalHistoryController"
            fitToWidth="true"
            fitToHeight="false"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            styleClass="main-container"
            style="-fx-background-color: transparent; -fx-padding: 0;">

    <VBox spacing="16.0" style="-fx-padding: 16px 20px 30px 20px;">

        <!-- Top Header & Patient Selector -->
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="card" style="-fx-padding: 12px 18px;">
            <Label text="👤" style="-fx-font-size: 18px;" />
            <Label text="Seleccionar Paciente:" styleClass="field-label" />
            <ComboBox fx:id="cbSelectPatient" prefWidth="280.0" promptText="Seleccionar paciente del archivo..." HBox.hgrow="ALWAYS" />
            <TextField fx:id="txtSearchPatient" promptText="O buscar por Cédula..." prefWidth="220.0" onAction="#handleSearchPatient" />
            <Button text="🔍 Buscar" onAction="#handleSearchPatient" styleClass="btn-secondary" style="-fx-padding: 6px 14px;" />
        </HBox>

        <!-- Selected Patient Info Banner -->
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="card" style="-fx-border-color: #0ea5e9; -fx-border-width: 0 0 0 4px; -fx-padding: 14px 20px;">
            <VBox alignment="CENTER" style="-fx-background-color: #e0f2fe; -fx-background-radius: 50px; -fx-min-width: 50px; -fx-min-height: 50px;">
                <Label text="🩺" style="-fx-font-size: 24px;" />
            </VBox>
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <Label fx:id="lblPatientName" text="Seleccione un paciente" style="-fx-font-weight: 800; -fx-font-size: 16px; -fx-text-fill: #0f172a;" />
                    <Label fx:id="lblPatientOriginBadge" text="🏠 Local" />
                </HBox>
                <HBox spacing="18.0">
                    <Label fx:id="lblPatientIdCard" text="C.I: V-00000000" style="-fx-font-size: 12px; -fx-font-weight: 700; -fx-text-fill: #0ea5e9;" />
                    <Label fx:id="lblPatientHistoryNum" text="Expediente: HC-0000-0000" style="-fx-font-size: 12px; -fx-text-fill: #64748b; -fx-font-weight: 600;" />
                    <Label fx:id="lblPatientAge" text="Edad: --" style="-fx-font-size: 12px; -fx-text-fill: #64748b;" />
                    <Label fx:id="lblPatientPhone" text="Tel: --" style="-fx-font-size: 12px; -fx-text-fill: #64748b;" />
                </HBox>
            </VBox>
        </HBox>

        <!-- Feedback Alert Banner -->
        <HBox fx:id="feedbackContainer" alignment="CENTER_LEFT" spacing="10.0" visible="false" managed="false">
            <Label fx:id="lblFeedback" text="Mensaje de confirmación o alerta" wrapText="true" />
        </HBox>

        <!-- Main Workspace: 2-Column Split -->
        <HBox spacing="18.0" alignment="TOP_LEFT">

            <!-- LEFT COLUMN: Consultation History & Details -->
            <VBox spacing="14.0" prefWidth="520.0" HBox.hgrow="ALWAYS">
                <!-- History Table Card -->
                <VBox spacing="8.0" styleClass="card" style="-fx-padding: 14px;">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="📋 Historial de Consultas Médicas" styleClass="section-title" style="-fx-font-size: 14px;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblHistoryCount" text="0 consultas" style="-fx-font-size: 11px; -fx-text-fill: #64748b; -fx-font-weight: 600;" />
                    </HBox>

                    <TableView fx:id="tableConsultations" prefHeight="220.0" styleClass="custom-table">
                        <columns>
                            <TableColumn fx:id="colDate" text="Fecha / Hora" prefWidth="130.0" />
                            <TableColumn fx:id="colReason" text="Motivo" prefWidth="130.0" />
                            <TableColumn fx:id="colDiagnosis" text="Diagnóstico" prefWidth="130.0" />
                            <TableColumn fx:id="colNextApp" text="Próx. Cita" prefWidth="85.0" />
                            <TableColumn fx:id="colActions" text="Acciones / Envío" prefWidth="120.0" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>
                </VBox>

                <!-- Selected Consultation Details Preview Card -->
                <VBox fx:id="selectedConsultationCard" spacing="10.0" styleClass="card" style="-fx-padding: 16px;" visible="false">
                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <Label fx:id="lblDetailConsultDate" text="Detalle de Consulta" style="-fx-font-weight: 800; -fx-font-size: 13px; -fx-text-fill: #0ea5e9;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnDownloadPdf" text="📄 PDF" onAction="#handleGeneratePdfCurrent" styleClass="btn-pdf-action">
                            <tooltip><Tooltip text="Ver y abrir informe médico PDF interactivo (AcroForms)" /></tooltip>
                        </Button>
                        <Button fx:id="btnWhatsApp" text="💬 WhatsApp" onAction="#handleSendWhatsAppCurrent" styleClass="btn-whatsapp">
                            <tooltip><Tooltip text="Enviar informe médico y récipe directamente por WhatsApp" /></tooltip>
                        </Button>
                        <Button fx:id="btnEmail" text="✉️ Gmail" onAction="#handleSendEmailCurrent" styleClass="btn-gmail">
                            <tooltip><Tooltip text="Enviar informe médico y prescripción por Correo (Gmail)" /></tooltip>
                        </Button>
                    </HBox>

                    <Separator />

                    <!-- Physical Data Bar -->
                    <Label fx:id="lblDetailPhysical" text="Talla: -- | Peso: -- | IMC: -- | Obs: --"
                           style="-fx-background-color: #f8fafc; -fx-padding: 6px 10px; -fx-background-radius: 6px; -fx-font-size: 11px; -fx-font-weight: 600; -fx-text-fill: #334155;" />

                    <VBox spacing="4.0">
                        <Label text="Motivo:" styleClass="field-label" />
                        <Label fx:id="lblDetailReason" text="Motivo de la consulta" wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #0f172a;" />
                    </VBox>

                    <VBox spacing="4.0">
                        <Label text="Evolución / Anotaciones:" styleClass="field-label" />
                        <Label fx:id="lblDetailEvolution" text="Evolución clínica detallada..." wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #475569;" />
                    </VBox>

                    <VBox spacing="4.0" style="-fx-background-color: #fef2f2; -fx-padding: 8px; -fx-background-radius: 6px; -fx-border-color: #fca5a5; -fx-border-radius: 6px;">
                        <Label text="Diagnóstico (Dx):" style="-fx-font-weight: 800; -fx-font-size: 11px; -fx-text-fill: #dc2626;" />
                        <Label fx:id="lblDetailDiagnosis" text="Diagnóstico clínico" wrapText="true" style="-fx-font-weight: 700; -fx-font-size: 12px; -fx-text-fill: #991b1b;" />
                    </VBox>

                    <VBox spacing="4.0" style="-fx-background-color: #f0fdf4; -fx-padding: 8px; -fx-background-radius: 6px; -fx-border-color: #86efac; -fx-border-radius: 6px;">
                        <Label text="Tratamiento Prescrito (Rx):" style="-fx-font-weight: 800; -fx-font-size: 11px; -fx-text-fill: #16a34a;" />
                        <Label fx:id="lblDetailRx" text="Prescripción farmacológica..." wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #14532d;" />
                    </VBox>

                    <Label fx:id="lblDetailNextApp" text="📅 Próxima Cita: --" style="-fx-font-weight: 700; -fx-font-size: 11px; -fx-text-fill: #6366f1;" />
                </VBox>
            </VBox>

            <!-- RIGHT COLUMN: New Consultation Registration Form -->
            <VBox spacing="12.0" prefWidth="540.0" HBox.hgrow="ALWAYS" styleClass="card" style="-fx-padding: 18px 20px;">
                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="2.0">
                        <Label text="➕ Registrar Nueva Consulta" styleClass="section-title" style="-fx-font-size: 15px;" />
                        <Label text="Ingresa los datos físicos, motivo, diagnóstico y récipe del paciente." styleClass="greeting-sublabel" />
                    </VBox>
                </HBox>

                <Separator />

                <!-- Motivo -->
                <VBox spacing="4.0">
                    <Label text="Motivo de Consulta *" styleClass="field-label" />
                    <TextField fx:id="txtReason" promptText="Ej. Dolor abdominal agudo, Control de rutina..." />
                </VBox>

                <!-- Datos Físicos (Talla, Peso, Observación) -->
                <VBox spacing="6.0" style="-fx-background-color: #f8fafc; -fx-padding: 10px 12px; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px;">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="📏 Datos Físicos" style="-fx-font-weight: 700; -fx-font-size: 12px; -fx-text-fill: #0ea5e9;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblBmiPreview" text="" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #0ea5e9;" />
                    </HBox>

                    <GridPane hgap="10.0" vgap="6.0">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="30.0" />
                            <ColumnConstraints percentWidth="30.0" />
                            <ColumnConstraints percentWidth="40.0" />
                        </columnConstraints>

                        <VBox spacing="2.0" GridPane.columnIndex="0">
                            <Label text="Talla (m)" style="-fx-font-size: 11px; -fx-text-fill: #475569;" />
                            <TextField fx:id="txtHeight" promptText="Ej. 1.75" />
                        </VBox>
                        <VBox spacing="2.0" GridPane.columnIndex="1">
                            <Label text="Peso (kg)" style="-fx-font-size: 11px; -fx-text-fill: #475569;" />
                            <TextField fx:id="txtWeight" promptText="Ej. 70.0" />
                        </VBox>
                        <VBox spacing="2.0" GridPane.columnIndex="2">
                            <Label text="Observación Física" style="-fx-font-size: 11px; -fx-text-fill: #475569;" />
                            <TextField fx:id="txtPhysicalNotes" promptText="Contextura, estado general..." />
                        </VBox>
                    </GridPane>
                </VBox>

                <!-- Evolución Clínica -->
                <VBox spacing="4.0">
                    <Label text="Anotaciones y Evolución Médica" styleClass="field-label" />
                    <TextArea fx:id="txtEvolution" promptText="Antecedentes, hallazgos en examen físico, evolución clínica..." prefRowCount="3" wrapText="true" />
                </VBox>

                <!-- ANOTACIONES PRIVADAS Y RESERVADAS DEL MEDICO / COMENTARIOS -->
                <VBox spacing="4.0" style="-fx-background-color: #fff1f2; -fx-border-color: #f43f5e; -fx-border-width: 1.5px; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 10px;">
                    <Label text="🔒 ANOTACIONES PRIVADAS Y RESERVADAS DEL MÉDICO / COMENTARIOS" style="-fx-font-size: 11px; -fx-font-weight: 900; -fx-text-fill: #be123c;" />
                    <Label text="Confidencial: Este campo es privado para lectura médica. No se anexa en ningún informe." style="-fx-font-size: 10px; -fx-text-fill: #e11d48;" />
                    <TextArea fx:id="txtPrivateDoctorNotes" promptText="Escribe aquí observaciones privadas, sospechas clínicas o comentarios confidenciales..." prefRowCount="3" wrapText="true" style="-fx-background-color: white; -fx-border-color: #fda4af; -fx-border-radius: 6px;" />
                </VBox>

                <!-- Diagnóstico -->
                <VBox spacing="4.0">
                    <Label text="Diagnóstico Clínico (Dx) *" styleClass="field-label" />
                    <TextField fx:id="txtDiagnosis" promptText="Ej. Gastritis aguda / Hipertensión arterial estadio 1" />
                </VBox>

                <!-- Tratamiento y Récipe -->
                <VBox spacing="4.0">
                    <Label text="Prescripción Farmacológica / Récipe (Rx)" styleClass="field-label" />
                    <TextArea fx:id="txtTreatmentRx" promptText="1. Medicamento A - 500mg cada 8 horas por 7 días&#10;2. Medicamento B - 1 comprimido diario en ayunas" prefRowCount="3" wrapText="true" />
                </VBox>

                <!-- Próxima Cita -->
                <VBox spacing="4.0">
                    <Label text="Fecha Sugerida de Próxima Cita (Control)" styleClass="field-label" />
                    <DatePicker fx:id="dpNextAppointment" promptText="dd/mm/aaaa" maxWidth="Infinity" />
                </VBox>

                <Separator />

                <!-- Action Buttons: Prominent and explicit -->
                <HBox spacing="10.0" alignment="CENTER_RIGHT" style="-fx-padding: 6px 0 0 0;">
                    <Button text="🧹 Limpiar" onAction="#handleClearForm" styleClass="btn-secondary" />
                    <Button text="💾 Guardar Consulta" onAction="#handleSaveConsultation" styleClass="btn-primary" style="-fx-font-weight: 800;" />
                    <Button text="📄 Guardar y Generar PDF" onAction="#handleSaveAndGeneratePdf" styleClass="btn-primary" style="-fx-background-color: linear-gradient(to right, #0d9488, #0f766e); -fx-font-weight: 800;" />
                </HBox>
            </VBox>

        </HBox>

    </VBox>

</ScrollPane>
