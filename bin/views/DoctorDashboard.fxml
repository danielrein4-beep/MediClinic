<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.mediclinic.controllers.DoctorDashboardController"
            prefWidth="1200.0" prefHeight="780.0"
            styleClass="main-container">

    <!-- Top Header -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="top-header">
            <!-- Dynamic Doctor Greeting -->
            <VBox spacing="2.0">
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label fx:id="lblGreeting" text="¡Bienvenido Dr. Mario Roa!" styleClass="greeting-label" />
                    <Label text="MÉDICO TITULAR" styleClass="badge-role-doctor" />
                </HBox>
                <Label fx:id="lblDoctorDetails" text="Medicina General y Cirugía | MPPS-84920" styleClass="greeting-sublabel" />
            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <!-- Currency Indicators with Interactive Edit Button & Logout -->
            <HBox alignment="CENTER_RIGHT" spacing="12.0">
                <HBox spacing="10.0" alignment="CENTER" styleClass="currency-pill">
                    <Label text="💵 Tasas del Día:" style="-fx-font-weight: bold; -fx-text-fill: #334155;" />
                    <Label fx:id="lblTasaVes" text="VES: Bs. 38.50" style="-fx-text-fill: #10b981; -fx-font-weight: bold;" />
                    <Label text="|" textFill="#cbd5e1" />
                    <Label fx:id="lblTasaCop" text="COP: $4,100" style="-fx-text-fill: #0ea5e9; -fx-font-weight: bold;" />
                    <Button text="✏️ Actualizar Tasas" onAction="#handleOpenRatesModal" styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 4px 8px;" />
                </HBox>

                <Button text="🚪 Cerrar Sesión" onAction="#handleLogout" styleClass="btn-danger" />
            </HBox>
        </HBox>
    </top>

    <!-- Sidebar Navigation with Interactive Calendar -->
    <left>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-width: 0 1px 0 0; -fx-border-color: #e2e8f0;">
            <VBox prefWidth="250.0" spacing="10.0" styleClass="sidebar">
                <Label text="PANEL DEL DOCTOR" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #94a3b8; -fx-padding: 0 0 4 6;" />

                <Button fx:id="btnNavDashboard" text="📊 Vista General" maxWidth="Infinity" styleClass="sidebar-btn, active" onAction="#showDashboardTab" />
                <Button fx:id="btnNavPatients" text="👥 Gestión de Pacientes" maxWidth="Infinity" styleClass="sidebar-btn" onAction="#showPatientsTab" />
                <Button fx:id="btnNavClinical" text="📋 Historias Clínicas" maxWidth="Infinity" styleClass="sidebar-btn" onAction="#showClinicalTab" />
                <Button fx:id="btnNavProcedures" text="💉 Procedimientos / Cotizaciones" maxWidth="Infinity" styleClass="sidebar-btn" onAction="#showProceduresTab" />
                <Button fx:id="btnNavWaitingRoom" text="⏳ Sala de Espera" maxWidth="Infinity" styleClass="sidebar-btn" onAction="#showWaitingRoomTab" />
                <Button fx:id="btnNavAgenda" text="📅 Agenda Médica" maxWidth="Infinity" styleClass="sidebar-btn" onAction="#showAgendaTab" />
                <Button fx:id="btnNavFinancialSummary" text="📊 Resúmenes Financieros" maxWidth="Infinity" styleClass="sidebar-btn" onAction="#showFinancialSummaryTab" />
                <Button fx:id="btnNavSettings" text="⚙️ Configuración &amp; Perfil" maxWidth="Infinity" styleClass="sidebar-btn" onAction="#showSettingsTab" />

                <Separator />

                <!-- Interactive Calendar Container -->
                <VBox fx:id="calendarSidebarContainer" spacing="6.0" alignment="TOP_CENTER" />

                <Region VBox.vgrow="ALWAYS" />

                <!-- Version badge -->
                <VBox alignment="CENTER" style="-fx-background-color: #f8fafc; -fx-padding: 10px; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px;">
                    <Label text="MediClinic Pro v2.0" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #0ea5e9;" />
                    <Label text="Base de Datos Local Segura" style="-fx-font-size: 10px; -fx-text-fill: #64748b;" />
                </VBox>
            </VBox>
        </ScrollPane>
    </left>

    <!-- Center Content Area -->
    <center>
        <StackPane fx:id="contentArea" style="-fx-padding: 20px;">
            <!-- Main Overview Dashboard VBox -->
            <ScrollPane fx:id="overviewScrollPane" fitToWidth="true" style="-fx-background-color: transparent;">
                <VBox spacing="18.0">
                    
                    <!-- Motor de Búsqueda Instantánea Destacado -->
                    <VBox styleClass="card" spacing="12.0" style="-fx-border-color: #0ea5e9; -fx-border-width: 1px 1px 1px 4px;">
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label text="🔍 Motor de Búsqueda Instantánea de Pacientes" styleClass="section-title" style="-fx-font-size: 15px;" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label text="Búsqueda por Cédula o Historia" style="-fx-font-size: 11px; -fx-text-fill: #64748b;" />
                        </HBox>

                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <TextField fx:id="txtQuickSearch" promptText="Ingresa la cédula (ej. V-18456789 o 18456789) o número de expediente..." HBox.hgrow="ALWAYS" onAction="#handleQuickSearch" />
                            <Button text="🔍 Buscar" onAction="#handleQuickSearch" styleClass="btn-primary" />
                            <Button text="➕ Nuevo Paciente" onAction="#showPatientsTab" styleClass="btn-secondary" />
                        </HBox>

                        <!-- Quick Search Result Card (Appears when searched) -->
                        <VBox fx:id="quickSearchResultCard" spacing="10.0" visible="false" managed="false"
                              style="-fx-background-color: #f8fafc; -fx-padding: 14px; -fx-background-radius: 10px; -fx-border-color: #cbd5e1; -fx-border-radius: 10px;">
                            <HBox alignment="CENTER_LEFT" spacing="14.0">
                                <VBox alignment="CENTER" style="-fx-background-color: #e0f2fe; -fx-background-radius: 50px; -fx-min-width: 48px; -fx-min-height: 48px;">
                                    <Label text="👤" style="-fx-font-size: 22px;" />
                                </VBox>
                                <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                    <HBox spacing="10.0" alignment="CENTER_LEFT">
                                        <Label fx:id="lblResultFullName" text="Nombre del Paciente" style="-fx-font-weight: 800; -fx-font-size: 15px; -fx-text-fill: #0f172a;" />
                                        <Label fx:id="lblResultOriginBadge" text="🏠 Local" />
                                    </HBox>
                                    <HBox spacing="16.0">
                                        <Label fx:id="lblResultIdCard" text="C.I: V-18456789" style="-fx-font-size: 12px; -fx-font-weight: 700; -fx-text-fill: #0ea5e9;" />
                                        <Label fx:id="lblResultHistory" text="Expediente: HC-2026-0001" style="-fx-font-size: 12px; -fx-text-fill: #64748b;" />
                                        <Label fx:id="lblResultPhone" text="Tel: 0412-1234567" style="-fx-font-size: 12px; -fx-text-fill: #64748b;" />
                                    </HBox>
                                </VBox>
                                <HBox spacing="8.0" alignment="CENTER_RIGHT">
                                    <Button text="📋 Historia Médica" onAction="#handleOpenFoundPatientClinicalHistory" styleClass="btn-primary" style="-fx-font-size: 11px;" />
                                    <Button text="👥 Ver Directorio" onAction="#showPatientsTab" styleClass="btn-secondary" style="-fx-font-size: 11px;" />
                                </HBox>
                            </HBox>
                        </VBox>

                        <!-- Not Found Card -->
                        <HBox fx:id="quickSearchNotFoundCard" alignment="CENTER_LEFT" spacing="12.0" visible="false" managed="false"
                              style="-fx-background-color: #fef2f2; -fx-padding: 12px; -fx-background-radius: 8px; -fx-border-color: #fca5a5; -fx-border-radius: 8px;">
                            <Label text="⚠️ No se encontró ningún paciente registrado con ese criterio de búsqueda." style="-fx-text-fill: #dc2626; -fx-font-weight: 600; -fx-font-size: 12px;" HBox.hgrow="ALWAYS" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button text="➕ Registrar Ahora" onAction="#showPatientsTab" styleClass="btn-primary" style="-fx-font-size: 11px;" />
                        </HBox>
                    </VBox>

                    <!-- KPI Cards Row -->
                    <HBox spacing="14.0">
                        <!-- KPI Card: Sala de Espera -->
                        <VBox styleClass="stat-card" prefWidth="220.0" spacing="6.0" style="-fx-border-color: #f59e0b; -fx-border-width: 0 0 0 4px;" HBox.hgrow="ALWAYS">
                            <Label text="EN SALA DE ESPERA" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #64748b;" />
                            <Label fx:id="lblStatWaiting" text="0" style="-fx-font-size: 28px; -fx-font-weight: 800; -fx-text-fill: #f59e0b;" />
                            <Label text="Turnos pendientes hoy" style="-fx-font-size: 11px; -fx-text-fill: #d97706;" />
                        </VBox>

                        <!-- KPI Card: Pacientes Hoy -->
                        <VBox styleClass="stat-card" prefWidth="220.0" spacing="6.0" style="-fx-border-color: #0ea5e9; -fx-border-width: 0 0 0 4px;" HBox.hgrow="ALWAYS">
                            <Label text="PACIENTES ATENDIDOS HOY" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #64748b;" />
                            <Label fx:id="lblStatToday" text="0" style="-fx-font-size: 28px; -fx-font-weight: 800; -fx-text-fill: #0ea5e9;" />
                            <Label text="Consultas registradas" style="-fx-font-size: 11px; -fx-text-fill: #10b981;" />
                        </VBox>

                        <!-- KPI Card: Total Pacientes -->
                        <VBox styleClass="stat-card" prefWidth="220.0" spacing="6.0" style="-fx-border-color: #10b981; -fx-border-width: 0 0 0 4px;" HBox.hgrow="ALWAYS">
                            <Label text="EXPEDIENTES REGISTRADOS" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #64748b;" />
                            <Label fx:id="lblStatTotal" text="0" style="-fx-font-size: 28px; -fx-font-weight: 800; -fx-text-fill: #10b981;" />
                            <Label text="Pacientes en base de datos" style="-fx-font-size: 11px; -fx-text-fill: #64748b;" />
                        </VBox>

                        <!-- KPI Card: Procedimientos Planificados -->
                        <VBox styleClass="stat-card" prefWidth="220.0" spacing="6.0" style="-fx-border-color: #6366f1; -fx-border-width: 0 0 0 4px;" HBox.hgrow="ALWAYS">
                            <Label text="PROCEDIMIENTOS SEMANA" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #64748b;" />
                            <Label fx:id="lblStatProcedures" text="0" style="-fx-font-size: 28px; -fx-font-weight: 800; -fx-text-fill: #6366f1;" />
                            <Label text="Cotizaciones multimoneda" style="-fx-font-size: 11px; -fx-text-fill: #64748b;" />
                        </VBox>
                    </HBox>

                    <!-- Overview Summary Card -->
                    <VBox styleClass="card" spacing="12.0">
                        <Label text="Panel de Control Médico" styleClass="section-title" />
                        <Label text="Gestiona expedientes de pacientes locales y foráneos, historias clínicas de consulta, cotizaciones multidivisa y estadísticas clínicas en tiempo real."
                               style="-fx-font-size: 13px; -fx-text-fill: #475569;" wrapText="true" />
                        
                        <Separator />

                        <HBox spacing="14.0" alignment="CENTER_LEFT">
                            <Button text="👥 Ver Directorio de Pacientes" onAction="#showPatientsTab" styleClass="btn-primary" />
                            <Button text="📋 Ver Historias Clínicas" onAction="#showClinicalTab" styleClass="btn-secondary" />
                            <Button text="💉 Cotizaciones y Procedimientos" onAction="#showProceduresTab" styleClass="btn-secondary" />
                        </HBox>
                    </VBox>
                </VBox>
            </ScrollPane>
        </StackPane>
    </center>

</BorderPane>
