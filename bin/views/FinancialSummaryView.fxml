<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mediclinic.controllers.FinancialSummaryViewController"
      spacing="16.0"
      styleClass="main-container">

    <!-- Top Header Bar with Interactive Time Filter -->
    <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="card" style="-fx-padding: 12px 18px;">
        <VBox spacing="2.0">
            <Label text="📊 Auditoría y Resúmenes Financieros" styleClass="section-title" style="-fx-font-size: 16px;" />
            <Label text="Historial consolidado de cierres de caja diarios y balances multidivisa para auditoría médica" style="-fx-font-size: 11px; -fx-text-fill: #64748b;" />
        </VBox>

        <Region HBox.hgrow="ALWAYS" />

        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <Label text="⏱️ Filtrar KPIs:" style="-fx-font-weight: 700; -fx-font-size: 11.5px; -fx-text-fill: #334155;" />
            <ComboBox fx:id="cbTimeFilter" prefWidth="165.0" styleClass="combo-box" style="-fx-font-size: 11.5px; -fx-font-weight: 600; -fx-cursor: hand;" />
            <Button text="🔄 Actualizar" onAction="#handleRefresh" styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 6px 14px; -fx-cursor: hand;" />
        </HBox>
    </HBox>

    <!-- KPI Summary Metrics (Quiet Luxury Cards) -->
    <HBox spacing="14.0">
        <!-- USD Summary -->
        <VBox HBox.hgrow="ALWAYS" styleClass="currency-box-usd" spacing="4.0">
            <Label text="TOTAL RECAUDADO (USD)" styleClass="currency-title" />
            <Label fx:id="lblTotalUsd" text="\$0.00 USD" styleClass="currency-value-usd" />
            <Label fx:id="lblUsdSub" text="Consolidado en Dólares" styleClass="currency-rate-sub" />
        </VBox>

        <!-- VES Summary -->
        <VBox HBox.hgrow="ALWAYS" styleClass="currency-box-ves" spacing="4.0">
            <Label text="TOTAL RECAUDADO (VES)" styleClass="currency-title" />
            <Label fx:id="lblTotalVes" text="Bs. 0.00 VES" styleClass="currency-value-ves" />
            <Label fx:id="lblVesSub" text="Consolidado en Bolívares" styleClass="currency-rate-sub" />
        </VBox>

        <!-- COP Summary -->
        <VBox HBox.hgrow="ALWAYS" styleClass="currency-box-cop" spacing="4.0">
            <Label text="TOTAL RECAUDADO (COP)" styleClass="currency-title" />
            <Label fx:id="lblTotalCop" text="\$0 COP" styleClass="currency-value-cop" />
            <Label fx:id="lblCopSub" text="Consolidado en Pesos" styleClass="currency-rate-sub" />
        </VBox>

        <!-- Total Closings & Patients -->
        <VBox HBox.hgrow="ALWAYS" styleClass="stat-card" spacing="4.0">
            <Label text="CIERRES AUDITADOS" style="-fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #64748b;" />
            <Label fx:id="lblTotalClosings" text="0 Cierres" style="-fx-font-size: 18px; -fx-font-weight: 800; -fx-text-fill: #0284c7;" />
            <Label fx:id="lblTotalPatients" text="0 Pacientes atendidos" style="-fx-font-size: 10px; -fx-text-fill: #64748b;" />
        </VBox>
    </HBox>

    <!-- Main Table Container -->
    <VBox spacing="10.0" VBox.vgrow="ALWAYS" styleClass="card" style="-fx-padding: 16px;">
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label text="Historial de Cierres de Caja" styleClass="section-title" style="-fx-font-size: 14px;" />
            <Region HBox.hgrow="ALWAYS" />
            <TextField fx:id="txtSearch" promptText="Buscar por fecha, responsable o notas..." prefWidth="280.0" />
        </HBox>

        <TableView fx:id="tableClosings" VBox.vgrow="ALWAYS" styleClass="custom-table">
            <columns>
                <TableColumn fx:id="colDate" text="Fecha Cierre" prefWidth="110.0" />
                <TableColumn fx:id="colTime" text="Hora" prefWidth="85.0" />
                <TableColumn fx:id="colPatients" text="Pacientes" prefWidth="85.0" />
                <TableColumn fx:id="colUsd" text="Total USD" prefWidth="120.0" />
                <TableColumn fx:id="colVes" text="Total VES" prefWidth="130.0" />
                <TableColumn fx:id="colCop" text="Total COP" prefWidth="120.0" />
                <TableColumn fx:id="colClosedBy" text="Responsable" prefWidth="150.0" />
                <TableColumn fx:id="colActions" text="Acción / Reporte" prefWidth="140.0" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </VBox>

</VBox>
