<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mediclinic.controllers.WaitingRoomViewController"
      spacing="14.0"
      styleClass="main-container">

    <!-- Top Bar: Metrics Header -->
    <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="card" style="-fx-padding: 10px 18px;">
        <VBox spacing="2.0">
            <Label text="⏳ Gestión de Sala de Espera &amp; Turnos" styleClass="section-title" style="-fx-font-size: 16px;" />
            <Label text="Control de admisión de pacientes y llamados a consulta médica en tiempo real" style="-fx-font-size: 11px; -fx-text-fill: #64748b;" />
        </VBox>

        <Region HBox.hgrow="ALWAYS" />

        <!-- Counter Pills -->
        <HBox spacing="10.0" alignment="CENTER_RIGHT">
            <HBox alignment="CENTER" spacing="6.0" style="-fx-background-color: #fef3c7; -fx-padding: 6px 12px; -fx-background-radius: 12px;">
                <Label text="⏳ En Espera:" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #92400e;" />
                <Label fx:id="lblCountWaiting" text="0" style="-fx-font-size: 13px; -fx-font-weight: 800; -fx-text-fill: #92400e;" />
            </HBox>

            <HBox alignment="CENTER" spacing="6.0" style="-fx-background-color: #e0e7ff; -fx-padding: 6px 12px; -fx-background-radius: 12px;">
                <Label text="🩺 En Consulta:" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #3730a3;" />
                <Label fx:id="lblCountInConsultation" text="0" style="-fx-font-size: 13px; -fx-font-weight: 800; -fx-text-fill: #3730a3;" />
            </HBox>

            <HBox alignment="CENTER" spacing="6.0" style="-fx-background-color: #d1fae5; -fx-padding: 6px 12px; -fx-background-radius: 12px;">
                <Label text="✅ Atendidos:" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #065f46;" />
                <Label fx:id="lblCountDone" text="0" style="-fx-font-size: 13px; -fx-font-weight: 800; -fx-text-fill: #065f46;" />
            </HBox>
        </HBox>
    </HBox>

    <!-- Main Content: Left Admission, Right Queue Table -->
    <HBox spacing="14.0" VBox.vgrow="ALWAYS">

        <!-- Left: Admission Card -->
        <VBox fx:id="cardAdmission" prefWidth="360.0" minWidth="320.0" spacing="12.0" styleClass="card" style="-fx-padding: 16px;">
            <Label text="➕ Registrar Llegada a Sala" styleClass="section-title" style="-fx-font-size: 14px;" />
            <Separator />

            <VBox spacing="6.0">
                <Label text="1. Buscar Paciente *" styleClass="field-label" />
                <HBox spacing="6.0" alignment="CENTER_LEFT">
                    <TextField fx:id="txtSearchPatient" promptText="Nombre o cédula..." HBox.hgrow="ALWAYS" />
                    <Button text="❌" onAction="#handleClearPatient" styleClass="btn-secondary" style="-fx-padding: 6px 10px;" />
                </HBox>

                <!-- Sugerencias -->
                <ListView fx:id="listSuggestions" prefHeight="100.0" visible="false" managed="false" />

                <!-- Paciente Seleccionado -->
                <VBox fx:id="cardSelectedPatient" visible="false" managed="false" spacing="2.0"
                      style="-fx-background-color: #f0fdf4; -fx-border-color: #86efac; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 8px 12px;">
                    <Label fx:id="lblPatientName" text="Nombre del Paciente" style="-fx-font-weight: 800; -fx-text-fill: #166534; -fx-font-size: 12px;" />
                    <Label fx:id="lblPatientIdCard" text="C.I: V-12345678" style="-fx-font-size: 11px; -fx-text-fill: #374151;" />
                    <Label fx:id="lblPatientPhone" text="📞 Tel: 0414-1234567" style="-fx-font-size: 11px; -fx-text-fill: #15803d; -fx-font-weight: 600;" />
                </VBox>
            </VBox>

            <VBox spacing="6.0">
                <Label text="2. Motivo de Consulta / Especialidad" styleClass="field-label" />
                <TextField fx:id="txtReason" promptText="Ej. Evaluación Médica General..." />
            </VBox>

            <VBox spacing="6.0">
                <Label text="3. Teléfono de Contacto / WhatsApp *" styleClass="field-label" />
                <TextField fx:id="txtContactPhone" promptText="Ej. 0414-1234567" />
            </VBox>

            <Label fx:id="lblAdmissionFeedback" text="" wrapText="true" style="-fx-font-size: 11px; -fx-font-weight: bold;" />

            <Region VBox.vgrow="ALWAYS" />

            <Button text="📥 Ingresar a Sala de Espera" onAction="#handleAdmitPatient" maxWidth="Infinity" styleClass="btn-primary" style="-fx-padding: 10px;" />
        </VBox>

        <!-- Right: Queue Table -->
        <VBox spacing="10.0" HBox.hgrow="ALWAYS" styleClass="card" style="-fx-padding: 14px;">
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label text="Turnos y Pacientes en Espera (Hoy)" styleClass="section-title" style="-fx-font-size: 14px;" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btnCloseDay" text="📊 Cerrar Caja y Jornada" onAction="#handleCloseDayAndCashRegister" styleClass="btn-primary" style="-fx-font-size: 11px; -fx-padding: 6px 14px; -fx-font-weight: bold; -fx-background-color: #0284c7; -fx-text-fill: white; -fx-cursor: hand;" />
            </HBox>

            <TableView fx:id="tableWaiting" VBox.vgrow="ALWAYS" styleClass="custom-table">
                <columns>
                    <TableColumn fx:id="colTurn" text="Turno" prefWidth="55.0" />
                    <TableColumn fx:id="colPatient" text="Paciente" prefWidth="160.0" />
                    <TableColumn fx:id="colPhone" text="Teléfono" prefWidth="110.0" />
                    <TableColumn fx:id="colArrival" text="Hora" prefWidth="75.0" />
                    <TableColumn fx:id="colReason" text="Motivo" prefWidth="130.0" />
                    <TableColumn fx:id="colStatus" text="Estado" prefWidth="95.0" />
                    <TableColumn fx:id="colPayment" text="Estado de Pago" prefWidth="140.0" />
                    <TableColumn fx:id="colActions" text="Acciones" prefWidth="160.0" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>

    </HBox>

</VBox>
